# Supabase (projeto "makerflow" já criado e com o schema aplicado)
NEXT_PUBLIC_SUPABASE_URL=cole_a_anon_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# Mercado Pago — PRODUÇÃO
# Gere em: https://www.mercadopago.com.br/developers/panel/app
# (crie/selecione uma aplicação → ative "Produção" → copie Access Token e Public Key)
MERCADOPAGO_ACCESS_TOKEN=cole_a_anon_key_aqui
MERCADOPAGO_PUBLIC_KEY=cole_a_anon_key_aqui

# Depois de configurar, cadastre a URL do webhook no painel do Mercado Pago:
#   https://SEU_DOMINIO/api/webhooks/mercadopago
#   Evento: "Assinaturas e Planos" (subscription_preapproval / preapproval)

# Melhor Envio (frete) — OAuth automático igual Mercado Pago/Mercado Livre.
# Crie o app em melhorenvio.com.br (ou sandbox.melhorenvio.com.br pra testar
# sem gastar nada de verdade, com saldo fictício de R$10.000) -> Gerenciar
# Aplicativos -> Novo Aplicativo. Cadastre nele:
#  - Redirect URI: https://SEU_DOMINIO/api/auth/melhor-envio/callback
# MELHOR_ENVIO_ENV controla qual host a integração usa (sandbox.melhorenvio.com.br
# ou www.melhorenvio.com.br) — os tokens são específicos de cada host, então
# trocar esse valor exige reconectar a integração.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_ENV=sandbox

# URL pública do site — usada pra montar links (ex: URL de webhook mostrada
# na tela de Integrações). Sem isso, cai no padrão de produção.
NEXT_PUBLIC_SITE_URL=https://studiomaker3d.com.br

# Integrações de vendas (Integrações no menu). Mercado Pago conecta via
# OAuth automático (o maker autoriza com um clique, sem colar token), usando
# um app SEPARADO chamado "MakerFlow Vendas" — diferente do "Makerflow3d"
# (MERCADOPAGO_ACCESS_TOKEN/PUBLIC_KEY acima, usado só pra assinatura do
# StudioMaker; não confundir os dois nem misturar credenciais). Pegue Client
# ID/Secret em Suas integrações -> app "MakerFlow Vendas" -> aba OAuth.
# Também precisa cadastrar, na mesma aplicação:
#  - Redirect URI: https://SEU_DOMINIO/api/auth/mercado-pago/callback
#  - URL de notificação webhook (evento "Pedidos"): https://SEU_DOMINIO/api/webhooks/mercado-pago
#  - Chave de assinatura do webhook (aparece junto da URL acima) -> MERCADO_PAGO_VENDAS_WEBHOOK_SECRET
MERCADO_PAGO_VENDAS_CLIENT_ID=
MERCADO_PAGO_VENDAS_CLIENT_SECRET=
MERCADO_PAGO_VENDAS_WEBHOOK_SECRET=

# Mercado Livre (marketplace, diferente do Mercado Pago) — OAuth automático
# igual o de cima. Crie o app em developers.mercadolivre.com.br (DevCenter,
# portal separado do painel do Mercado Pago). Cadastre nele:
#  - Redirect URI: https://SEU_DOMINIO/api/auth/mercado-livre/callback
#  - URL de notificação (tópico "orders_v2"): https://SEU_DOMINIO/api/webhooks/mercado-livre
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=

# Shopee e TikTok Shop usam OAuth de app e SÓ FUNCIONAM depois que o app do
# StudioMaker for aprovado nas duas plataformas; até lá, deixe essas variáveis
# vazias — os botões de conectar ficam desabilitados automaticamente.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=

# Telemetria em tempo real de impressoras (webhook/bridge, seção "Impressoras
# em Tempo Real" no Dashboard) — desligada por padrão, substituída pelo
# controle patrimonial em Cadastros → Impressoras. Troque pra "true" pra
# reativar (o código todo continua no repositório, só fica sem uso).
NEXT_PUBLIC_ENABLE_REALTIME_TELEMETRY=false

# InfinitePay — segunda forma de pagamento da Loja Online, só pra loja
# configurada em NEXT_PUBLIC_INFINITEPAY_STORE_SLUG (dinheiro cai direto
# na conta dessa InfiniteTag; não é multi-tenant como o Mercado Pago).
# Handle (@usuario, sem o $) — não é secreto, mas cadastre a URL de
# webhook no painel da InfinitePay apontando pra:
#   https://SEU_DOMINIO/api/webhooks/infinitepay
INFINITEPAY_HANDLE=
NEXT_PUBLIC_INFINITEPAY_STORE_SLUG=studio-diniz

# Upstash Redis — limita tentativas de checkout da Loja Online por IP (rota
# pública, sem login, que cria cobrança de verdade). Crie um banco Redis
# grátis em console.upstash.com -> Create Database -> aba "REST API" tem as
# duas variáveis já prontas pra copiar. Sem isso configurado, o checkout
# continua funcionando normalmente, só sem limite (loga um aviso no console).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry — monitoramento de erro/ataque com alerta por e-mail. Crie conta
# grátis em sentry.io -> Create Project (escolha "Next.js") -> copie o DSN
# em Settings -> Client Keys (DSN). Sem isso configurado, o app funciona
# normal, só sem monitoramento (não é segredo, pode ficar público).
NEXT_PUBLIC_SENTRY_DSN=
