# Supabase (projeto "makerflow" já criado e com o schema aplicado)
NEXT_PUBLIC_SUPABASE_URL=cole_a_anon_key_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_a_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_aqui

# Mercado Pago — PRODUÇÃO
# Gere em: https://www.mercadopago.com.br/developers/panel/app
# (crie/selecione uma aplicação → ative "Produção" → copie Access Token e Public Key)
MERCADOPAGO_ACCESS_TOKEN=cole_a_anon_key_aqui
MERCADOPAGO_PUBLIC_KEY=cole_a_anon_key_aqui

# Depois de configurar, cadastre a URL do webhook no painel do Mercado Pago:
#   https://SEU_DOMINIO/api/webhooks/mercadopago
#   Evento: "Assinaturas e Planos" (subscription_preapproval / preapproval)

# Optional: Melhor Envio (shipping)
MELHORENVIO_TOKEN=cole_a_anon_key_aqui

# URL pública do site — usada pra montar links (ex: URL de webhook mostrada
# na tela de Integrações). Sem isso, cai no padrão de produção.
NEXT_PUBLIC_SITE_URL=https://maker-flow.netlify.app

# Integrações de vendas (Integrações no menu). Mercado Pago conecta via
# OAuth automático (o maker autoriza com um clique, sem colar token), usando
# um app SEPARADO chamado "MakerFlow Vendas" — diferente do "Makerflow3d"
# (MERCADOPAGO_ACCESS_TOKEN/PUBLIC_KEY acima, usado só pra assinatura do
# MakerFlow; não confundir os dois nem misturar credenciais). Pegue Client
# ID/Secret em Suas integrações -> app "MakerFlow Vendas" -> aba OAuth.
# Também precisa cadastrar, na mesma aplicação:
#  - Redirect URI: https://SEU_DOMINIO/api/auth/mercado-pago/callback
#  - URL de notificação webhook (evento "Pedidos"): https://SEU_DOMINIO/api/webhooks/mercado-pago
#  - Chave de assinatura do webhook (aparece junto da URL acima) -> MERCADO_PAGO_VENDAS_WEBHOOK_SECRET
MERCADO_PAGO_VENDAS_CLIENT_ID=
MERCADO_PAGO_VENDAS_CLIENT_SECRET=
MERCADO_PAGO_VENDAS_WEBHOOK_SECRET=

# Shopee e TikTok Shop usam OAuth de app e SÓ FUNCIONAM depois que o app do
# MakerFlow for aprovado nas duas plataformas; até lá, deixe essas variáveis
# vazias — os botões de conectar ficam desabilitados automaticamente.
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=
# TIKTOK_APP_KEY=
# TIKTOK_APP_SECRET=
