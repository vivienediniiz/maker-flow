# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# Se preferir, deixe em branco e o script pergunta tudo no terminal na primeira vez.

# Dados da impressora — aparecem na tela dela, em Configuracoes de Rede.
# A impressora precisa estar com "LAN Only Mode" (Modo Somente LAN) ativado.
PRINTER_IP=192.168.1.100
PRINTER_SERIAL=AC12309BH109
PRINTER_ACCESS_CODE=12345678

# Chave da impressora cadastrada no StudioMaker.
# Pegue em Cadastros -> Impressoras, no botao de copiar chave daquela impressora.
MAKERFLOW_API_KEY=cole_a_chave_aqui

# URL do StudioMaker. Use a de producao por padrao, ou http://localhost:3000 em dev local.
MAKERFLOW_URL=https://maker-flow.netlify.app

# Intervalo entre leituras, em segundos (recomendado: 10 a 15).
POLL_INTERVAL_SECONDS=12

# Camera (opcional) - so funciona se a impressora tiver camera.
# A1 / A1 Mini / P1P / P1S usam protocolo proprio (porta 6000, sem dependencia
# externa); X1 / X1C usam RTSPS de verdade (porta 322, via ffmpeg). O bridge
# tenta os dois automaticamente - nao precisa dizer qual modelo e.
ENABLE_CAMERA=false
SNAPSHOT_INTERVAL_SECONDS=4
